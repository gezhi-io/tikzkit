\usetikzlibrary {datavisualization}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization
 [scientific axes=clean,
  all axes={grid,ticks={step=1}},
  visualize as line=baseline,
  visualize as scatter=samples,
  baseline={style={blue, thick},label in legend={text=trend}},
  samples={style={red, mark=x, mark size=2pt},label in legend={text=measurements}}]
data {
  x, y, set
  0, 0, baseline
  1, 1, baseline
  2, 1, baseline
  3, 2, baseline
  4, 3, baseline
  0, 0.2, samples
  1, 0.8, samples
  2, 1.3, samples
  3, 1.7, samples
  4, 3.1, samples
};
\end{tikzpicture}
