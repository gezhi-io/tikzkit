\usetikzlibrary {datavisualization.formats.functions}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization [
  school book axes,
  all axes={unit length=7.5mm},
  every data set label/.append style={text colored},
  visualize as smooth line/.list={rise,fall},
  rise={label in data={text=$r$, when=x is 2}},
  fall={pin in data={text=$f$, when=x is 2}},
  style sheet=strong colors,
  data/format=function]
data [set=rise] {
  var x : interval [0:4] samples 25;
  func y = .25*\value x;
}
data [set=fall] {
  var x : interval [0:4] samples 25;
  func y = 1-.2*\value x;
};
\end{tikzpicture}
