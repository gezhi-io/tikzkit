\usetikzlibrary {datavisualization.formats.functions}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization [
  scientific axes,
  visualize as line=line,
  legend={label style=text left},
  line={label in legend={text=$f$}},
  data/format=function]
data {
  var x : interval [0:2] samples 3;
  func y = \value x;
};
\end{tikzpicture}
