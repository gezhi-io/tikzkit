\usetikzlibrary {datavisualization.formats.functions}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization [
  scientific axes,
  visualize as smooth line,
  x axis={ticks={major={
    no tick text at = 3,
    also at = (pi) as [{tick text padding=1ex}] $\pi$}}},
  data/format=function]
data {
  var x : interval [0:2*pi] samples 50;
  func y = sin(\value x r);
};
\end{tikzpicture}
