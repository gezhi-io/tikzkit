\usetikzlibrary {datavisualization.formats.functions}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization [
  scientific axes=clean,
  x axis={min value=0,max value=2},
  y axis={min value=0,max value=2},
  visualize as smooth line/.list={a,b},
  legend={right of={x=1,y=1}},
  a={label in legend={text=a}},
  b={label in legend={text=b}},
  style sheet=strong colors,
  data/format=function]
data [set=a] {
  var x : interval [0:2] samples 20;
  func y = \value x;
}
data [set=b] {
  var x : interval [0:2] samples 20;
  func y = 2-\value x;
};
\end{tikzpicture}
