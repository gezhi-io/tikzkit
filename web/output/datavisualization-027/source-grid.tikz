\usetikzlibrary {datavisualization,plotmarks}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization
 [scientific axes=clean,
  all axes={ticks={step=1},grid},
  visualize as scatter/.list={a,b},
  style sheet=cross marks,
  a={label in legend={text=a}},
  b={label in legend={text=b}}]
data {
  x, y, set
  0, 0, a
  1, 1, a
  2, 0.5, a
  0, 1, b
  1, 0.2, b
  2, 1.4, b
};
\end{tikzpicture}
