\usetikzlibrary {datavisualization.formats.functions}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization
 [scientific axes=clean,
  visualize as line=line,
  line={style={mark=x}, label in legend={text=example, straight label in legend line}},
  data/format=function]
data {
  var x : interval [0:1] samples 2;
  func y = \value x;
};
\end{tikzpicture}
