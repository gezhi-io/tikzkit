\usetikzlibrary {datavisualization.formats.functions}
\begin{tikzpicture}
  \draw[overlay, step=1cm, line width=0.12pt, dash pattern=on 0.7pt off 0.7pt, black!45] (-50,-50) grid (50,50);
  \datavisualization [
  scientific axes=clean,
  visualize as scatter=samples,
  samples={
    style={mark=*,mark size=1.5pt},
    label in legend={
      text=custom marks,
      label in legend mark coordinates={(-2em,0),(0,0)}
    }}]
data point [x=0,y=0,set=samples];
\end{tikzpicture}
