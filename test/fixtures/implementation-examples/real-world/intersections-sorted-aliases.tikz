\usetikzlibrary{intersections}
\begin{tikzpicture}
  \draw[help lines] (-2.5,-1.5) grid (2.5,1.5);
  \draw[red, very thick, name path=descending] (2,0) -- (-2,0);
  \draw[blue, very thick, name path=route]
    (-1,-1) -- (-1,1) -- (1,1) -- (1,-1);

  \path[name intersections={of=descending and route, sort by=route,
    by={[label=below:left]left,[label=below:right]right}}];
  \fill[orange] (left) circle (2.5pt) node[below] {left};
  \fill[green!60!black] (right) circle (2.5pt) node[below] {right};
\end{tikzpicture}
